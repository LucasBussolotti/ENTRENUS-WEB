# Copiar a .env.local y completar. .env.local nunca se commitea.

# ── Resend (mail de respaldo de los formularios) ──
RESEND_API_KEY=

# ── Anthropic (chat libre de Nuti, /api/nutibot) ──
# Sin esta clave el chat responde con un mensaje de error y quedan sólo las opciones.
# Conviene fijar un límite de gasto mensual en console.anthropic.com.
ANTHROPIC_API_KEY=

# ── Odoo · Reclutamiento ──
# Raíz del servidor, sin barra final y SIN /odoo ni /web (ahi vive el cliente web, no el API).
# Ejemplo: https://train-entrenuts.adhoc.inc
ODOO_URL=
ODOO_DB=
# Usuario (login/email) y API key generada en Odoo: Preferencias > Seguridad de la cuenta > Clave API
ODOO_USERNAME=
ODOO_API_KEY=

# Opcionales: por defecto busca el puesto llamado "Trabaja con Nosotros".
# ODOO_JOB_NAME=Trabaja con Nosotros
# ODOO_JOB_ID=

# ── Destino de los formularios ──
# Obligatorias junto con MAIL_FROM: no hay valores por defecto en el código.
# Casilla que recibe las postulaciones laborales.
CONTACT_EMAIL=
# Casilla que recibe los leads de "Quiero ser distribuidor".
DISTRIBUTOR_EMAIL=
# Remitente. Requiere un dominio verificado en Resend para entregar a terceros;
# onboarding@resend.dev solo sirve para probar contra tu propia casilla.
# Ejemplo: Entrenuts Web <web@entrenuts.com.ar>
MAIL_FROM=

# ── Portal de distribuidores ──
# URL externa del portal. Si queda vacía, la tarjeta muestra un aviso en vez del botón.
NEXT_PUBLIC_DISTRIBUTOR_PORTAL_URL=

# ── Rate limiting (opcional) ──
# Sin esto el contador de los formularios es por instancia. Con credenciales de
# Upstash Redis pasa a ser global a todas las réplicas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL pública del sitio (canonical, hreflang, sitemap, Open Graph). Sin barra final.
# Si no se define se usa https://entrenuts.com.ar (sin www: www redirige al dominio sin www)
NEXT_PUBLIC_SITE_URL=https://entrenuts.com.ar
