# Copiar a .env.local y completar. .env.local nunca se commitea.

# ── Resend (mail de respaldo de los formularios) ──
RESEND_API_KEY=

# ── Odoo · Reclutamiento ──
# Raíz del servidor, sin barra final y SIN /odoo ni /web (ahi vive el cliente web, no el API).
# Ejemplo: https://train-entrenuts.adhoc.inc
ODOO_URL=
ODOO_DB=
# Usuario (login/email) y API key generada en Odoo: Preferencias > Seguridad de la cuenta > Clave API
ODOO_USERNAME=
ODOO_API_KEY=

# Opcionales: por defecto busca el puesto llamado "Trabaja con Nosotros".
# ODOO_JOB_NAME=Trabaja con Nosotros
# ODOO_JOB_ID=
